<!doctype html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
  <%- include('partials/header') %>
  <main id="main">
    <section class="section page-head bg-muted">
      <div class="container">
        <p class="eyebrow reveal">Insights</p>
        <h1 class="display reveal"><%= intro && intro.title ? intro.title : 'Thinking out loud' %></h1>
        <p class="lede reveal">Research, opinion and practical guidance on reaching multicultural Australia.</p>
        <% if (categories.length) { %>
          <div class="filter-row reveal">
            <a class="chip <%= activeCategory ? '' : 'is-active' %>" href="/insights">All</a>
            <% categories.forEach(c => { %>
              <a class="chip <%= activeCategory === c ? 'is-active' : '' %>" href="/insights?category=<%= encodeURIComponent(c) %>"><%= c %></a>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>
    <section class="section">
      <div class="container">
        <% if (!items.length) { %><p class="lede">Nothing published yet.</p><% } %>
        <div class="grid cols-3">
          <% items.forEach(item => { %>
            <a class="card insight-card reveal" href="/insights/<%= item.slug %>">
              <% if (item.hero_image) { %><div class="insight-card-media"><img src="<%= item.hero_image %>" alt="" loading="lazy"></div><% } %>
              <p class="work-meta"><%= [item.category, item.date_label].filter(Boolean).join(' · ') %></p>
              <h3><%= item.title %></h3>
              <p><%= item.excerpt %></p>
              <span class="card-arrow">→</span>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
