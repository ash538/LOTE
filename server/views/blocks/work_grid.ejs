<section class="section bg-<%= data.background || 'paper' %>">
  <div class="container">
    <div class="section-head reveal">
      <% if (data.eyebrow) { %><p class="eyebrow"><%= data.eyebrow %></p><% } %>
      <% if (data.heading) { %><h2 class="section-title"><%= data.heading %></h2><% } %>
      <% if (data.intro) { %><p class="lede"><%= data.intro %></p><% } %>
    </div>
    <% if (data.show_filters && (source.sectors || []).length) { %>
      <div class="filter-row reveal">
        <a class="chip is-active" href="/work">All</a>
        <% source.sectors.forEach(sector => { %><a class="chip" href="/work?sector=<%= encodeURIComponent(sector) %>"><%= sector %></a><% }) %>
      </div>
    <% } %>
    <div class="work-grid">
      <% (source.items || []).forEach(item => { %>
        <a class="work-card reveal" href="/work/<%= item.slug %>">
          <div class="work-card-media">
            <% if (item.thumbnail || item.hero_image) { %>
              <img src="<%= item.thumbnail || item.hero_image %>" alt="" loading="lazy">
            <% } else { %>
              <span class="work-card-placeholder">
                <b><%= (item.client || item.title).slice(0, 2).toUpperCase() %></b>
                <em><%= item.client || item.sector || 'Case study' %></em>
              </span>
            <% } %>
          </div>
          <div class="work-card-body">
            <p class="work-meta"><%= [item.client, item.sector, item.year].filter(Boolean).join(' · ') %></p>
            <h3><%= item.title %></h3>
            <p><%= item.summary %></p>
            <% if ((item.service_tags || []).length) { %>
              <div class="tag-row"><% item.service_tags.forEach(tag => { %><span class="tag"><%= tag %></span><% }) %></div>
            <% } %>
          </div>
        </a>
      <% }) %>
    </div>
    <% if (data.link_label) { %>
      <div class="section-foot reveal"><a class="btn btn-secondary" href="<%= data.link_url || '/work' %>"><%= data.link_label %></a></div>
    <% } %>
  </div>
</section>
