<section class="section shell" <% if (block.anchor) { %>id="<%= block.anchor %>"<% } %> data-reveal>
  <div class="section-grid">
    <div class="section-title">
      <% if (data.eyebrow) { %><span class="eyebrow accent"><%= data.eyebrow %></span><% } %>
      <h2 class="display"><%- h.escapeHtml(data.heading).replace(/\n/g, '<br />') %></h2>
      <% if (data.intro) { %><p class="copy"><%= data.intro %></p><% } %>
    </div>
    <div class="story-list">
      <% (data.items || []).forEach((item, i) => { %>
        <article class="story">
          <span class="eyebrow accent"><%= String(i + 1).padStart(2, '0') %> / <%= item.eyebrow %></span>
          <h3 class="display"><%- h.escapeHtml(item.heading).replace(/\n/g, '<br />') %></h3>
          <p><%= item.text %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>
