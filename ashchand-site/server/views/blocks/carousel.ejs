<section class="section shell bg-<%= data.background || 'butter' %>" <% if (block.anchor) { %>id="<%= block.anchor %>"<% } %> data-reveal>
  <% if (data.eyebrow || data.heading) { %>
    <div class="carousel-head">
      <% if (data.eyebrow) { %><span class="eyebrow accent"><%= data.eyebrow %></span><% } %>
      <% if (data.heading) { %><h2 class="display size-medium"><%- h.escapeHtml(data.heading).replace(/\n/g, '<br />') %></h2><% } %>
    </div>
  <% } %>
  <div class="carousel" data-carousel aria-roledescription="carousel">
    <div class="carousel-track" data-carousel-track>
      <% (data.items || []).forEach((item, i) => { %>
        <figure class="carousel-slide" role="group" aria-roledescription="slide"
                aria-label="<%= i + 1 %> of <%= (data.items || []).length %>">
          <blockquote>“<%= item.quote %>”</blockquote>
          <figcaption>
            <strong><%= item.person %></strong><% if (item.role) { %><span><%= item.role %></span><% } %>
          </figcaption>
        </figure>
      <% }) %>
    </div>
    <% if ((data.items || []).length > 1) { %>
      <div class="carousel-controls">
        <button type="button" class="carousel-arrow" data-carousel-prev aria-label="Previous quote">←</button>
        <div class="carousel-dots" data-carousel-dots></div>
        <button type="button" class="carousel-arrow" data-carousel-next aria-label="Next quote">→</button>
      </div>
    <% } %>
  </div>
</section>
