{
  "name": "lote-quote-builder",
  "version": "1.0.0",
  "description": "Online quote builder with backend rates for team use",
  "private": true,
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npx react-scripts start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npx react-scripts build",
    "seed": "node server/seed.js",
    "seed:demo": "node server/seed.js --demo",
    "start": "node server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
