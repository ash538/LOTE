{
  "name": "lote-website",
  "version": "1.0.0",
  "description": "LOTE Marketing website with a built-in CMS, plus the internal quote builder",
  "private": true,
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npx react-scripts start",
    "dev": "node server/index.js",
    "build": "cd client && npx react-scripts build",
    "seed": "node server/seed.js && node server/cms/seed.js",
    "start": "node server/index.js",
    "dev:quote-builder": "concurrently \"npm run server\" \"npm run client\"",
    "seed:cms": "node server/cms/seed.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "ejs": "^6.0.1",
    "express": "^4.21.0",
    "multer": "^2.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
